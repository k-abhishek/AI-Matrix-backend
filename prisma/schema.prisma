datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum CrawlRunStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
  CANCELLED
  INTERRUPTED
}

enum PageStatus {
  DISCOVERED
  QUEUED
  PROCESSING
  FETCHED
  SKIPPED
  FAILED
  COMPLETED
}

model Crawler {
  id              String         @id @default(uuid())
  name            String
  sitemapUrl      String
  baseUrl         String
  allowedHosts    String[]
  includePatterns String[]       @default([])
  excludePatterns String[]       @default([])
  settings        Json?
  enabled         Boolean        @default(true)
  isRunning       Boolean        @default(false)
  scope           KnowledgeScope @default(WORKSPACE)
  workspaceId     String?
  knowledgeBaseId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  crawlRuns       CrawlRun[]
  crawledPages    CrawledPage[]
  knowledgeBase   KnowledgeBase? @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([knowledgeBaseId])
  @@map("crawlers")
}

model CrawlRun {
  id                 String         @id @default(uuid())
  crawlerId          String
  status             CrawlRunStatus @default(PENDING)
  totalPages         Int            @default(0)
  discoveredPages    Int            @default(0)
  queuedPages        Int            @default(0)
  processingPages    Int            @default(0)
  fetchedPages       Int            @default(0)
  cleanedPages       Int            @default(0)
  skippedPages       Int            @default(0)
  failedPages        Int            @default(0)
  totalChunks        Int            @default(0)
  embeddedChunks     Int            @default(0)
  storedChunks       Int            @default(0)
  storageUsedBytes   BigInt         @default(0)
  averageFetchTimeMs Float          @default(0)
  errorMessage       String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  crawler            Crawler        @relation(fields: [crawlerId], references: [id], onDelete: Cascade)
  pages              CrawlRunPage[]

  @@index([crawlerId])
  @@index([status])
  @@map("crawl_runs")
}

model CrawledPage {
  id            String         @id @default(uuid())
  crawlerId     String
  url           String
  canonicalUrl  String
  title         String?
  description   String?
  contentHash   String?
  httpStatus    Int?
  contentBytes  Int            @default(0)
  chunksCount   Int            @default(0)
  status        PageStatus     @default(DISCOVERED)
  lastCrawledAt DateTime?
  lastError     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  crawler       Crawler        @relation(fields: [crawlerId], references: [id], onDelete: Cascade)
  chunks        CrawledChunk[]

  @@unique([crawlerId, canonicalUrl])
  @@index([crawlerId])
  @@index([canonicalUrl])
  @@map("crawled_pages")
}

model CrawledChunk {
  id             String      @id @default(uuid())
  pageId         String
  qdrantPointId  String
  chunkIndex     Int
  contentHash    String
  tokenCount     Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  page           CrawledPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, chunkIndex])
  @@index([pageId])
  @@index([qdrantPointId])
  @@map("crawled_chunks")
}

model CrawlRunPage {
  id              String      @id @default(uuid())
  crawlRunId      String
  url             String
  status          PageStatus  @default(DISCOVERED)
  httpStatus      Int?
  fetchDurationMs Int?
  contentBytes    Int         @default(0)
  chunksCount     Int         @default(0)
  errorMessage    String?
  processedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  crawlRun        CrawlRun    @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)

  @@index([crawlRunId])
  @@index([status])
  @@map("crawl_run_pages")
}

// ==========================================
// CONNECTOR PLATFORM ENUMS
// ==========================================

enum ConnectorType {
  NATIVE
  MCP
  CUSTOM_REST
}

enum ConnectionAuthType {
  NONE
  API_KEY
  BEARER_TOKEN
  BASIC_AUTH
  OAUTH2_AUTHORIZATION_CODE
  OAUTH2_CLIENT_CREDENTIALS
  CUSTOM_HEADERS
}

enum ConnectionStatus {
  INITIALIZING
  CONNECTED
  DISCONNECTED
  ERROR
  EXPIRED
  REVOKED
}

enum McpTransportType {
  STREAMABLE_HTTP
  LEGACY_HTTP_SSE
  STDIO_ISOLATED
}

enum ToolExecutionStatus {
  SUCCESS
  FAILED
  TIMED_OUT
  PERMISSION_DENIED
  APPROVAL_REQUIRED
}

// ==========================================
// CONNECTOR PLATFORM MODELS
// ==========================================

model ConnectorDefinition {
  id            String               @id @default(uuid())
  key           String               @unique // e.g. "gmail", "slack", "github", "mcp-server", "custom-rest"
  name          String
  description   String
  type          ConnectorType
  supportedAuth ConnectionAuthType[]
  iconUrl       String?
  docUrl        String?
  isSystem      Boolean              @default(true)
  defaultConfig Json?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  connections   ConnectorConnection[]

  @@map("connector_definitions")
}

model ConnectorConnection {
  id                    String              @id @default(uuid())
  workspaceId           String              // Clerk orgId or fallback to userId
  userId                String              // Creator Clerk userId
  connectorDefinitionId String
  name                  String
  status                ConnectionStatus    @default(INITIALIZING)
  authType              ConnectionAuthType
  
  baseUrl               String?
  mcpTransport          McpTransportType?
  config                Json?
  
  lastConnectedAt       DateTime?
  lastTestedAt          DateTime?
  lastDiscoveredAt      DateTime?
  lastErrorMessage      String?
  configVersion         Int                 @default(1)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  connectorDefinition   ConnectorDefinition @relation(fields: [connectorDefinitionId], references: [id], onDelete: Restrict)
  credential            ConnectorCredential?
  tools                 ConnectorTool[]
  resources             ConnectorResource[]
  prompts               ConnectorPrompt[]
  permissions           ConnectorPermission[]
  agentBindings         AgentConnectorBinding[]
  oauthTransactions     OAuthTransaction[]

  @@index([workspaceId])
  @@index([userId])
  @@index([connectorDefinitionId])
  @@index([status])
  @@map("connector_connections")
}

model ConnectorCredential {
  id                    String              @id @default(uuid())
  connectionId          String              @unique
  encryptedData         String              // AES-256-GCM ciphertext
  iv                    String              // Initialization vector (Base64)
  authTag               String              // GCM authentication tag (Base64)
  keyId                 String              @default("v1")
  expiresAt             DateTime?
  refreshTokenExpiresAt DateTime?
  tokenType             String?             // e.g. "Bearer"
  scopes                String[]            @default([])
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  connection            ConnectorConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("connector_credentials")
}

model ConnectorTool {
  id               String              @id @default(uuid())
  connectionId     String
  name             String
  displayName      String
  description      String
  inputSchema      Json
  outputSchema     Json?
  schemaHash       String?
  isEnabled        Boolean             @default(true)
  requiresApproval Boolean             @default(false)
  rateLimitPerMin  Int?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  connection       ConnectorConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, name])
  @@index([connectionId])
  @@index([isEnabled])
  @@map("connector_tools")
}

model ConnectorResource {
  id               String              @id @default(uuid())
  connectionId     String
  uri              String              // MCP Resource URI (e.g. file:///docs/readme.md)
  name             String
  description      String?
  mimeType         String?
  isIndexed        Boolean             @default(false)
  lastReadAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  connection       ConnectorConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, uri])
  @@index([connectionId])
  @@map("connector_resources")
}

model ConnectorPrompt {
  id               String              @id @default(uuid())
  connectionId     String
  name             String              // MCP Prompt template name
  description      String?
  arguments        Json?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  connection       ConnectorConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, name])
  @@index([connectionId])
  @@map("connector_prompts")
}

model ConnectorPermission {
  id           String              @id @default(uuid())
  connectionId String
  workspaceId  String
  role         String?
  userId       String?
  canExecute   Boolean             @default(true)
  canManage    Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  connection   ConnectorConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, workspaceId, userId])
  @@index([workspaceId])
  @@map("connector_permissions")
}

model AgentConnectorBinding {
  id               String              @id @default(uuid())
  agentId          String
  connectionId     String
  workspaceId      String
  allowedToolNames String[]            @default([])
  isEnabled        Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  connection       ConnectorConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([agentId, connectionId])
  @@index([agentId])
  @@index([workspaceId])
  @@map("agent_connector_bindings")
}

model OAuthTransaction {
  id           String              @id @default(uuid())
  connectionId String
  state        String              @unique
  codeVerifier String?
  redirectUri  String
  scopes       String[]            @default([])
  expiresAt    DateTime
  createdAt    DateTime            @default(now())

  connection   ConnectorConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([state])
  @@index([expiresAt])
  @@map("oauth_transactions")
}

model ConnectorAuditLog {
  id           String              @id @default(uuid())
  workspaceId  String
  connectionId String
  userId       String?
  agentId      String?
  action       String
  details      Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime            @default(now())

  @@index([workspaceId])
  @@index([connectionId])
  @@index([createdAt])
  @@map("connector_audit_logs")
}

// ==========================================
// CONFIGURABLE AGENT PLATFORM ENUMS
// ==========================================

enum AgentVisibility {
  PERSONAL
  WORKSPACE
}

enum AgentStatus {
  ACTIVE
  ARCHIVED
}

enum AgentVersionStatus {
  DRAFT
  VALIDATED
  PUBLISHED
  DEPRECATED
  REVOKED
}

enum AgentApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

// ==========================================
// CONFIGURABLE AGENT PLATFORM MODELS
// ==========================================

model Agent {
  id              String          @id @default(uuid())
  workspaceId     String
  createdByUserId String
  ownerUserId     String
  visibility      AgentVisibility @default(PERSONAL)
  name            String
  description     String?
  slug            String
  isSystem        Boolean         @default(false)
  status          AgentStatus     @default(ACTIVE)
  activeVersionId String?
  draftConfig     Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  versions        AgentVersion[]
  knowledgeBases  AgentKnowledgeBase[]
  skills          AgentSkill[]
  toolGrants      AgentToolGrant[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, status])
  @@index([workspaceId, visibility, ownerUserId])
  @@map("agents")
}

model AgentVersion {
  id                 String             @id @default(uuid())
  agentId            String
  versionNumber      Int
  status             AgentVersionStatus @default(DRAFT)
  configHash         String
  systemInstructions String
  provider           String?
  model              String?
  temperature        Float              @default(0.7)
  maxTokens          Int?
  maxIterations      Int                @default(15)
  timeoutMs          Int                @default(60000)
  memoryConfig       Json?
  executionPolicy    Json?
  publishedAt        DateTime?
  publishedByUserId  String?
  revokedAt          DateTime?
  revokedByUserId    String?
  revokedReason      String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  agent              Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  approvals          AgentApproval[]
  knowledgeBases     AgentKnowledgeBase[]
  skills             AgentSkill[]
  toolGrants         AgentToolGrant[]

  @@unique([agentId, versionNumber])
  @@index([agentId, status])
  @@map("agent_versions")
}

model AgentApproval {
  id               String              @id @default(uuid())
  workspaceId      String
  runId            String
  conversationId   String
  agentVersionId   String
  userId           String
  toolName         String
  connectionId     String?
  interruptId      String?
  parameters       Json?
  status           AgentApprovalStatus @default(PENDING)
  resolvedByUserId String?
  resolvedAt       DateTime?
  expiresAt        DateTime
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  agentVersion     AgentVersion        @relation(fields: [agentVersionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([runId])
  @@index([conversationId])
  @@map("agent_approvals")
}

// ==========================================
// KNOWLEDGE BASE & SKILL & TOOL GRANT ENUMS
// ==========================================

enum KnowledgeScope {
  PLATFORM
  WORKSPACE
}

enum KnowledgeBaseStatus {
  ACTIVE
  ARCHIVED
  QUARANTINED
}

enum KnowledgeSourceType {
  CRAWLER_PAGE
  FILE
  TEXT
}

enum KnowledgeDocumentStatus {
  INDEXING
  ACTIVE
  FAILED
  QUARANTINED
}

enum SkillScope {
  PLATFORM
  WORKSPACE
  PERSONAL
}

enum SkillCategory {
  INSTRUCTION
  TOOL
  WORKFLOW
}

enum SkillStatus {
  ACTIVE
  ARCHIVED
}

enum SkillVersionStatus {
  DRAFT
  PUBLISHED
  DEPRECATED
  REVOKED
}

enum CapabilityType {
  BUILTIN
  CONNECTOR
  MCP
}

enum ConnectionScope {
  WORKSPACE_SHARED
  USER_DELEGATED
}

// ==========================================
// KNOWLEDGE BASE MODELS
// ==========================================

model KnowledgeBase {
  id                String              @id @default(uuid())
  scope             KnowledgeScope      @default(WORKSPACE)
  workspaceId       String?
  ownerUserId       String
  name              String
  description       String?
  qdrantCollection  String
  retrievalDefaults Json?
  status            KnowledgeBaseStatus @default(ACTIVE)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  crawlers          Crawler[]
  documents         KnowledgeDocument[]
  agentLinks        AgentKnowledgeBase[]

  @@index([scope, status])
  @@index([workspaceId, status])
  @@map("knowledge_bases")
}

model KnowledgeDocument {
  id              String                  @id @default(uuid())
  knowledgeBaseId String
  workspaceId     String?
  sourceType      KnowledgeSourceType
  sourceRefId     String?
  title           String
  uri             String?
  contentHash     String
  chunkCount      Int                     @default(0)
  status          KnowledgeDocumentStatus @default(ACTIVE)
  metadata        Json?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  knowledgeBase   KnowledgeBase           @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@index([knowledgeBaseId, status])
  @@index([workspaceId])
  @@map("knowledge_documents")
}

model AgentKnowledgeBase {
  id              String        @id @default(uuid())
  agentId         String
  agentVersionId  String?
  knowledgeBaseId String
  retrievalConfig Json?
  isEnabled       Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  agent           Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentVersion    AgentVersion? @relation(fields: [agentVersionId], references: [id], onDelete: Cascade)
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([agentVersionId])
  @@index([knowledgeBaseId])
  @@map("agent_knowledge_bases")
}

// ==========================================
// SKILL REGISTRY & TOOL GRANT MODELS
// ==========================================

model Skill {
  id              String         @id @default(uuid())
  scope           SkillScope     @default(PERSONAL)
  workspaceId     String?
  createdByUserId String
  ownerUserId     String
  key             String
  name            String
  description     String?
  category        SkillCategory  @default(INSTRUCTION)
  activeVersionId String?
  status          SkillStatus    @default(ACTIVE)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  versions        SkillVersion[]
  agentSkills     AgentSkill[]

  @@unique([scope, workspaceId, key])
  @@index([scope, workspaceId, status])
  @@map("skills")
}

model SkillVersion {
  id                   String             @id @default(uuid())
  skillId              String
  versionNumber        Int
  status               SkillVersionStatus @default(DRAFT)
  summary              String
  instructions         String
  inputSchema          Json?
  requiredCapabilities String[]           @default([])
  permittedToolKeys    String[]           @default([])
  workflowDefinition   Json?
  settingsSchema       Json?
  configHash           String
  publishedAt          DateTime?
  publishedByUserId    String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  skill                Skill              @relation(fields: [skillId], references: [id], onDelete: Cascade)
  agentSkills          AgentSkill[]

  @@unique([skillId, versionNumber])
  @@index([skillId, status])
  @@map("skill_versions")
}

model AgentSkill {
  id               String        @id @default(uuid())
  agentId          String
  agentVersionId   String?
  skillId          String
  skillVersionId   String?
  isEnabled        Boolean       @default(true)
  priority         Int           @default(0)
  settingsOverride Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  agent            Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentVersion     AgentVersion? @relation(fields: [agentVersionId], references: [id], onDelete: Cascade)
  skill            Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillVersion     SkillVersion? @relation(fields: [skillVersionId], references: [id], onDelete: SetNull)

  @@index([agentId])
  @@index([agentVersionId])
  @@index([skillId])
  @@map("agent_skills")
}

model AgentToolGrant {
  id               String          @id @default(uuid())
  agentId          String
  agentVersionId   String?
  workspaceId      String
  capabilityType   CapabilityType
  toolKey          String
  connectionScope  ConnectionScope @default(WORKSPACE_SHARED)
  connectionId     String?
  allowedToolNames String[]        @default([])
  requiresApproval Boolean         @default(false)
  isEnabled        Boolean         @default(true)
  constraints      Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  agent            Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentVersion     AgentVersion?   @relation(fields: [agentVersionId], references: [id], onDelete: Cascade)

  @@index([agentId, workspaceId])
  @@index([agentVersionId])
  @@map("agent_tool_grants")
}

// ==========================================
// INDIAN LEGAL KNOWLEDGE BASE ENUMS
// ==========================================

enum LegalDomain {
  CONSTITUTIONAL
  CRIMINAL
  CIVIL
  CORPORATE_COMMERCIAL
  LABOUR_EMPLOYMENT
  FAMILY
  TAXATION
  CONSUMER_PROTECTION
  PROPERTY_REAL_ESTATE
  CYBER_TECHNOLOGY
  BANKING_FINANCIAL
  ADMINISTRATIVE_REGULATORY
  INTELLECTUAL_PROPERTY
  ENVIRONMENTAL
  STATE_LEGISLATION
}

enum LegalDocumentType {
  CONSTITUTION
  CENTRAL_ACT
  STATE_ACT
  AMENDMENT_ACT
  RULE
  REGULATION
  NOTIFICATION
  CIRCULAR
  ORDINANCE
  SUPREME_COURT_JUDGMENT
  HIGH_COURT_JUDGMENT
  TRIBUNAL_DECISION
}

enum LegalAuthorityTier {
  PRIMARY_LEGISLATION
  OFFICIAL_AMENDMENT
  OFFICIAL_NOTIFICATION
  BINDING_JUDICIAL
  PERSUASIVE_JUDICIAL
  SECONDARY_COMMENTARY
  UNVERIFIED
}

enum LegalVerificationStatus {
  VERIFIED
  PENDING_REVIEW
  DISPUTED
  UNVERIFIED
}

enum LegalProvisionType {
  PART
  CHAPTER
  SECTION
  ARTICLE
  REGULATION
  RULE
  SUBSECTION
  CLAUSE
  SUB_CLAUSE
  PROVISO
  EXPLANATION
  SCHEDULE
}

enum LegalProvisionStatus {
  ACTIVE
  AMENDED
  REPEALED
  SUPERSEDED
  PARTIAL_COMMENCEMENT
}

enum LegalPrecedentWeight {
  BINDING
  PERSUASIVE
  OVERRULED
  DISTINGUISHED
}

enum LegalRelationshipType {
  AMENDS
  REPEALS
  SAVES
  INTERPRETS
  OVERRULES
  DISTINGUISHES
  CROSS_REFERENCES
  SUPPLEMENTS
}

// ==========================================
// INDIAN LEGAL KNOWLEDGE BASE MODELS
// ==========================================

model LegalSource {
  id                 String                  @id @default(uuid())
  name               String                  @unique
  sourceKey          String?                 @unique
  sourceType         String                  @default("LEGISLATION") // LEGISLATION, GAZETTE, JUDICIAL
  authorityTier      LegalAuthorityTier
  baseUrl            String                  @unique
  jurisdiction       String                  @default("INDIA")
  jurisdictionLevel  String                  @default("CENTRAL")
  ingestionMethod    String                  @default("WEB_CRAWL")
  enabled            Boolean                 @default(true)
  description        String?
  verificationStatus LegalVerificationStatus @default(VERIFIED)
  crawlConfig        Json?
  metadata           Json?
  ingestionStatus    String                  @default("PENDING") // PENDING, RUNNING, COMPLETED, PARTIALLY_COMPLETED, FAILED
  lastIngestionAt    DateTime?
  lastSuccessAt      DateTime?
  discoveredCount    Int                     @default(0)
  downloadedCount    Int                     @default(0)
  extractedCount     Int                     @default(0)
  persistedCount     Int                     @default(0)
  indexedCount       Int                     @default(0)
  failedCount        Int                     @default(0)
  lastError          String?
  lastRunId          String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  documents          LegalDocument[]
  discoveredDocs     DiscoveredLegalDocument[]

  @@index([authorityTier])
  @@index([enabled, ingestionStatus])
  @@map("legal_sources")
}

model LegalIngestionRun {
  id                      String    @id @default(uuid())
  runType                 String    @default("INITIAL_LEGAL_IMPORT")
  status                  String    @default("PENDING") // PENDING, RUNNING, COMPLETED, PARTIALLY_COMPLETED, FAILED
  startedAt               DateTime  @default(now())
  completedAt             DateTime?
  discoveredCount         Int       @default(0)
  downloadedCount         Int       @default(0)
  extractedCount          Int       @default(0)
  persistedCount          Int       @default(0)
  indexedCount            Int       @default(0)
  failedCount             Int       @default(0)
  duplicateCount          Int       @default(0)
  pendingReviewCount      Int       @default(0)
  lastProcessedDocumentId String?
  errorSummary            String?
  reportJson              Json?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([runType, status])
  @@map("legal_ingestion_runs")
}

model DiscoveredLegalDocument {
  id               String    @id @default(uuid())
  knowledgeSourceId String
  title            String
  originalUrl      String
  canonicalUrl     String    @unique
  fileType         String
  mimeType         String?
  fileSize         Int?
  sha256           String?
  storageReference String?
  legalDocumentId  String?
  discoveredAt     DateTime  @default(now())
  downloadedAt     DateTime?
  downloadStatus   String    @default("PENDING") // PENDING, DOWNLOADED, FAILED, DUPLICATE
  processingStatus String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, PENDING_REVIEW
  lastError        String?
  metadata         Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  knowledgeSource  LegalSource @relation(fields: [knowledgeSourceId], references: [id], onDelete: Cascade)

  @@index([knowledgeSourceId, downloadStatus, processingStatus])
  @@index([sha256])
  @@map("discovered_legal_documents")
}

model LegalDocument {
  id                 String                  @id @default(uuid())
  title              String
  shortTitle         String?
  documentType       LegalDocumentType
  legalDomain        LegalDomain
  jurisdiction       String                  @default("IN")
  state              String?
  actNumber          String?
  enactmentDate      DateTime?
  commencementDate   DateTime?
  repealedDate       DateTime?
  status             LegalProvisionStatus    @default(ACTIVE)
  sourceId           String
  sourceUrl          String
  verificationStatus LegalVerificationStatus @default(VERIFIED)
  contentHash        String
  rawMongoId         String?
  metadata           Json?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  source             LegalSource             @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  versions           LegalDocumentVersion[]
  provisions         LegalProvision[]
  judgment           LegalJudgment?
  amendmentsAsActor  LegalAmendment[]        @relation("AmendingDocument")
  amendmentsAsTarget LegalAmendment[]        @relation("TargetDocument")
  citationsFrom      LegalCitation[]         @relation("CitationSourceDocument")
  citationsTo        LegalCitation[]         @relation("CitationTargetDocument")
  relationshipsFrom  LegalRelationship[]     @relation("RelationshipFromDocument")
  relationshipsTo    LegalRelationship[]     @relation("RelationshipToDocument")

  @@index([legalDomain, jurisdiction, state])
  @@index([documentType, status])
  @@index([shortTitle])
  @@index([actNumber])
  @@map("legal_documents")
}

model LegalDocumentVersion {
  id              String                  @id @default(uuid())
  documentId      String
  versionNumber   Int
  effectiveFrom   DateTime?
  effectiveUntil  DateTime?
  isCurrent       Boolean                 @default(true)
  amendmentNote   String?
  contentHash     String
  rawMongoId      String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  document        LegalDocument           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  provisionVersions LegalProvisionVersion[]

  @@unique([documentId, versionNumber])
  @@index([documentId, isCurrent])
  @@map("legal_document_versions")
}

model LegalProvision {
  id              String                  @id @default(uuid())
  documentId      String
  parentId        String?
  provisionType   LegalProvisionType
  provisionNumber String
  heading         String?
  hierarchyPath   String
  sortOrder       Int                     @default(0)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  document        LegalDocument           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  parent          LegalProvision?         @relation("ProvisionHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children        LegalProvision[]        @relation("ProvisionHierarchy")
  versions        LegalProvisionVersion[]
  amendments      LegalAmendment[]        @relation("TargetProvision")
  citations       LegalCitation[]         @relation("CitationTargetProvision")
  relationshipsFrom LegalRelationship[]   @relation("RelationshipFromProvision")
  relationshipsTo   LegalRelationship[]   @relation("RelationshipToProvision")

  @@unique([documentId, hierarchyPath])
  @@index([documentId, provisionNumber])
  @@index([parentId])
  @@map("legal_provisions")
}

model LegalProvisionVersion {
  id                    String               @id @default(uuid())
  provisionId           String
  documentVersionId     String
  versionNumber         Int                  @default(1)
  exactText             String
  effectiveFrom         DateTime?
  effectiveUntil        DateTime?
  isCurrent             Boolean              @default(true)
  status                LegalProvisionStatus @default(ACTIVE)
  commencementUncertain Boolean              @default(false)
  uncertaintyNote       String?
  contentHash           String
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  provision             LegalProvision       @relation(fields: [provisionId], references: [id], onDelete: Cascade)
  documentVersion       LegalDocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  chunks                LegalProvisionChunk[]

  @@unique([provisionId, documentVersionId])
  @@index([provisionId, isCurrent])
  @@index([effectiveFrom, effectiveUntil])
  @@index([status])
  @@map("legal_provision_versions")
}

model LegalProvisionChunk {
  id                 String                @id @default(uuid())
  provisionVersionId String
  chunkIndex         Int
  qdrantPointId      String                @unique
  contentHash        String
  tokenCount         Int                   @default(0)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  provisionVersion   LegalProvisionVersion @relation(fields: [provisionVersionId], references: [id], onDelete: Cascade)

  @@unique([provisionVersionId, chunkIndex])
  @@index([provisionVersionId])
  @@map("legal_provision_chunks")
}

model LegalAmendment {
  id                 String         @id @default(uuid())
  amendingDocumentId String
  targetDocumentId   String
  targetProvisionId  String?
  amendmentType      String         // SUBSTITUTED, INSERTED, OMITTED, REPEALED, SAVED
  effectiveDate      DateTime?
  description        String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  amendingDocument   LegalDocument  @relation("AmendingDocument", fields: [amendingDocumentId], references: [id], onDelete: Cascade)
  targetDocument     LegalDocument  @relation("TargetDocument", fields: [targetDocumentId], references: [id], onDelete: Cascade)
  targetProvision    LegalProvision? @relation("TargetProvision", fields: [targetProvisionId], references: [id], onDelete: SetNull)

  @@index([targetDocumentId])
  @@index([targetProvisionId])
  @@map("legal_amendments")
}

model LegalJudgment {
  id                 String                  @id @default(uuid())
  documentId         String                  @unique
  caseName           String
  court              String
  caseNumber         String?
  judgmentDate       DateTime
  citation           String?
  bench              String?
  precedentWeight    LegalPrecedentWeight    @default(BINDING)
  paragraphCount     Int?
  sourceUrl          String
  verificationStatus LegalVerificationStatus @default(VERIFIED)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  document           LegalDocument           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  citations          LegalCitation[]         @relation("CitationTargetJudgment")

  @@index([court, judgmentDate])
  @@index([citation])
  @@index([caseName])
  @@map("legal_judgments")
}

model LegalCitation {
  id                String          @id @default(uuid())
  sourceDocumentId  String
  targetDocumentId  String?
  targetProvisionId String?
  targetJudgmentId  String?
  paragraphRefs     String[]        @default([])
  citationText      String
  createdAt         DateTime        @default(now())

  sourceDocument    LegalDocument   @relation("CitationSourceDocument", fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  targetDocument    LegalDocument?  @relation("CitationTargetDocument", fields: [targetDocumentId], references: [id], onDelete: SetNull)
  targetProvision   LegalProvision? @relation("CitationTargetProvision", fields: [targetProvisionId], references: [id], onDelete: SetNull)
  targetJudgment    LegalJudgment?  @relation("CitationTargetJudgment", fields: [targetJudgmentId], references: [id], onDelete: SetNull)

  @@index([sourceDocumentId])
  @@index([targetProvisionId])
  @@index([targetJudgmentId])
  @@map("legal_citations")
}

model LegalRelationship {
  id               String                @id @default(uuid())
  fromDocumentId   String
  toDocumentId     String
  fromProvisionId  String?
  toProvisionId    String?
  relationshipType LegalRelationshipType
  effectiveDate    DateTime?
  notes            String?
  createdAt        DateTime              @default(now())

  fromDocument     LegalDocument         @relation("RelationshipFromDocument", fields: [fromDocumentId], references: [id], onDelete: Cascade)
  toDocument       LegalDocument         @relation("RelationshipToDocument", fields: [toDocumentId], references: [id], onDelete: Cascade)
  fromProvision    LegalProvision?       @relation("RelationshipFromProvision", fields: [fromProvisionId], references: [id], onDelete: SetNull)
  toProvision      LegalProvision?       @relation("RelationshipToProvision", fields: [toProvisionId], references: [id], onDelete: SetNull)

  @@index([fromDocumentId, relationshipType])
  @@index([toDocumentId, relationshipType])
  @@index([fromProvisionId])
  @@index([toProvisionId])
  @@map("legal_relationships")
}

