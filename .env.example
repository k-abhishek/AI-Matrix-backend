# Application
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Authentication & Vault (Clerk & AES-256-GCM)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
ENCRYPTION_MASTER_KEY=

# OAuth Providers & Redirects
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:4000/api/oauth/callback
FRONTEND_REDIRECT_BASE_URL=http://localhost:5173/connector

# Databases (PostgreSQL / Prisma & MongoDB / Mongoose)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/website_crawler?schema=public
MONGODB_URL=mongodb://localhost:27017/chat

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=website_content
QDRANT_VECTOR_SIZE=768
QDRANT_DISTANCE=Cosine

# Embeddings
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_BATCH_SIZE=32
GOOGLE_API_KEY=

# Agent & LLM (Supports Google Gemini, Groq, OpenAI, Anthropic Claude)
AGENT_PROVIDER=auto
AGENT_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Crawler Engine
CRAWLER_MAX_CONCURRENCY=3
CRAWLER_REQUEST_TIMEOUT_MS=15000
CRAWLER_MAX_PAGES_PER_RUN=1000
CRAWLER_MAX_RESPONSE_BYTES=5242880
CRAWLER_MAX_REDIRECTS=5
CRAWLER_DEFAULT_DELAY_MS=500

# Storage Budget & Management
QDRANT_STORAGE_BUDGET_BYTES=4294967296
QDRANT_STORAGE_STOP_THRESHOLD_PERCENT=85

# Chunking Configuration
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# Third-Party Integrations
BRANDFETCH_API_KEY=
